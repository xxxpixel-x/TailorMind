# 衣语 TailorMind — 服务端大模型与生图接口配置（OpenAI 兼容格式）
# 支持火山引擎豆包 Ark / DeepSeek / 硅基流动 SiliconFlow / 通义千问 DashScope 等
LIANGYI_LLM_BASE_URL=https://api.deepseek.com/v1
LIANGYI_LLM_API_KEY=
LIANGYI_LLM_MODEL=deepseek-chat

# 可选：实时 AI 生图接口配置（如硅基流动 Kwai-Kolors/Kolors 或火山引擎 Seedream）
LIANGYI_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
LIANGYI_IMAGE_API_KEY=
LIANGYI_IMAGE_MODEL=Kwai-Kolors/Kolors

# 公网 Demo 速率限制配置
LIANGYI_RATE_LIMIT_PER_MIN=6
LIANGYI_RATE_LIMIT_PER_DAY=30
